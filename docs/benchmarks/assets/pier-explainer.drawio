<mxfile host="65bd71144e">
    <diagram id="pier-explainer" name="Pier Explainer">
        <mxGraphModel dx="1575" dy="771" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;Pier: Why It Exists and How It Runs Coding-Agent Evaluations&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;A Harbor-compatible harness for installed agents, filtered-network sandboxes, normalized trajectories, and post-run analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1640" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="&lt;b&gt;Why Pier exists&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="560" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="w1" value="&lt;b&gt;Smaller Harbor fork&lt;/b&gt;&lt;br&gt;Keep Harbor task compatibility, but use a narrower and more opinionated evaluation surface." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="why" vertex="1">
                    <mxGeometry x="30" y="55" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w2" value="&lt;b&gt;Installed agents in filtered-network tasks&lt;/b&gt;&lt;br&gt;Agent adapters declare install steps and provider allowlists, so native CLIs can run inside the sandbox." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="why" vertex="1">
                    <mxGeometry x="290" y="55" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w3" value="&lt;b&gt;Stricter ATIF trajectories&lt;/b&gt;&lt;br&gt;Normalize native agent logs into explicit steps, tool calls, reasoning fields, timestamps, and usage metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="why" vertex="1">
                    <mxGeometry x="30" y="215" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="&lt;b&gt;Viewer and critique built in&lt;/b&gt;&lt;br&gt;Pier treats trajectories as first-class artifacts for inspection, critique jobs, and post-run analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;spacing=10;" parent="why" vertex="1">
                    <mxGeometry x="290" y="215" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bridge" value="&lt;b&gt;Pier turns task packages into sandboxed agent trials&lt;/b&gt;" style="shape=mxgraph.flowchart.manualInput;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="630" y="240" width="120" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="arch" value="&lt;b&gt;Runtime architecture&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;" parent="1" vertex="1">
                    <mxGeometry x="790" y="140" width="890" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;CLI and Job&lt;/b&gt;&lt;br&gt;`pier run` builds a job config, resolves datasets, and emits trial configs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="25" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;TrialExecution&lt;/b&gt;&lt;br&gt;Creates the concrete agent and environment for one task instance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="195" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;AgentFactory&lt;/b&gt;&lt;br&gt;Loads the installed-agent adapter, env vars, CLI flags, and post-run hooks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="365" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;EnvironmentFactory&lt;/b&gt;&lt;br&gt;Starts the sandbox with the agent&#39;s install spec and network allowlist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="535" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="&lt;b&gt;Agent run inside sandbox&lt;/b&gt;&lt;br&gt;Native CLI writes logs and a provider-specific trajectory file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="705" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="&lt;b&gt;Pier post-processing&lt;/b&gt;&lt;br&gt;Convert native logs to ATIF, upload artifacts, run verifier, and expose results to `pier view` and critique jobs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;spacing=10;" parent="arch" vertex="1">
                    <mxGeometry x="220" y="220" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" parent="arch" source="a1" target="a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="arch" source="a2" target="a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" parent="arch" source="a3" target="a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c026d3;strokeWidth=2;endArrow=block;endFill=1;" parent="arch" source="a4" target="a5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="post-run conversion and grading" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#db2777;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#831843;" parent="arch" source="a5" target="a6" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="780" y="200"/>
                            <mxPoint x="440" y="200"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="flow" value="&lt;b&gt;DeepSWE-style run with `mini-swe-agent`&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="550" width="1640" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="&lt;b&gt;1. Local Harbor-format dataset&lt;/b&gt;&lt;br&gt;This build accepts local dataset paths only. DeepSWE-style usage therefore starts from a converted/exported task directory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="25" y="80" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="&lt;b&gt;2. Configure `mini-swe-agent`&lt;/b&gt;&lt;br&gt;Set `model_name`, provider env vars, and optional `reasoning_effort` or `config_yaml`." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="270" y="80" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="&lt;b&gt;3. Install and allowlist&lt;/b&gt;&lt;br&gt;Pier installs the CLI with `uv`, derives provider URLs, and filters egress to the declared domains." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="515" y="80" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="&lt;b&gt;4. Run native mini CLI&lt;/b&gt;&lt;br&gt;`mini-swe-agent --yolo --model=... --task=... --output=/logs/agent/mini-swe-agent.trajectory.json`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="760" y="80" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="&lt;b&gt;5. Convert to ATIF&lt;/b&gt;&lt;br&gt;Pier saves `agent/trajectory.json` with explicit steps, tool calls, observations, timestamps, and metrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="1025" y="80" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f6" value="&lt;b&gt;6. Verify and inspect&lt;/b&gt;&lt;br&gt;Verifier reads sandbox outputs, and the job stores results under `jobs/&lt;job&gt;/&lt;trial&gt;/` for `pier view` and critique." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="1280" y="80" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="&lt;b&gt;Important limit&lt;/b&gt;&lt;br&gt;Pier does not ship a first-party DeepSWE downloader in the inspected build. The dataset must already exist locally in Harbor-style task form." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;spacing=10;" parent="flow" vertex="1">
                    <mxGeometry x="420" y="220" width="820" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" parent="flow" source="f1" target="f2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" parent="flow" source="f2" target="f3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;" parent="flow" source="f3" target="f4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;" parent="flow" source="f4" target="f5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;" parent="flow" source="f5" target="f6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="&lt;b&gt;README status&lt;/b&gt;&lt;br&gt;Documents `docker` and `modal` as the main supported environments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="110" y="885" width="280" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="&lt;b&gt;Code status&lt;/b&gt;&lt;br&gt;Environment factory also registers Daytona, so the implementation surface is slightly ahead of the README." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f99d;strokeColor=#65a30d;fontColor=#365314;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="460" y="885" width="320" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="m3" value="&lt;b&gt;Bottom line&lt;/b&gt;&lt;br&gt;Pier is best read as execution and analysis infrastructure for coding-agent benchmarks, not as a benchmark corpus itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="930" y="885" width="380" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="&lt;b&gt;Best fit&lt;/b&gt;&lt;br&gt;Use Pier when you want native agent CLIs, filtered-network sandboxes, and high-quality normalized trajectories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecdd3;strokeColor=#e11d48;fontColor=#881337;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1370" y="885" width="310" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c2410c;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="why" target="bridge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="bridge" target="arch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" value="same shared-harness idea as DeepSWE, but with stronger sandbox and trajectory plumbing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#4c1d95;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="bridge" target="f4" edge="1">
                    <mxGeometry x="-0.4468" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="690" y="600"/>
                            <mxPoint x="920" y="600"/>
                        </Array>
                        <mxPoint y="-1" as="offset"/>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
