<mxfile host="65bd71144e">
    <diagram id="deepswe-explainer" name="DeepSWE Explainer">
        <mxGraphModel dx="1575" dy="771" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;DeepSWE: Why It Works as a New Software Engineering Benchmark&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Designed to measure novel, long-horizon coding ability instead of public-patch recall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1640" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="problem" value="&lt;b&gt;Why older public benchmarks under-measure real SWE work&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="760" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b&gt;Contamination risk&lt;/b&gt;&lt;br&gt;Tasks derived from public commits or PRs may already exist in pretraining data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="30" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="&lt;b&gt;Narrow task scope&lt;/b&gt;&lt;br&gt;Prompts can be long and prescriptive while the actual implementation change stays small." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="270" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="&lt;b&gt;Verifier mismatch&lt;/b&gt;&lt;br&gt;Inherited PR tests can pass wrong patches or reject reasonable solutions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="510" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="&lt;b&gt;Practical effect&lt;/b&gt;&lt;br&gt;Leaderboards can compress model differences and reward test-fitting more than codebase exploration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="150" y="220" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="solution" value="&lt;b&gt;How DeepSWE is built to measure the right thing&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;" parent="1" vertex="1">
                    <mxGeometry x="920" y="140" width="760" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="&lt;b&gt;Original tasks&lt;/b&gt;&lt;br&gt;Prompts, verifiers, and reference solutions are written from scratch and not merged upstream." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="solution" vertex="1">
                    <mxGeometry x="30" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="&lt;b&gt;Broad repository diversity&lt;/b&gt;&lt;br&gt;113 tasks span 91 repositories and 5 languages, limiting overfitting to a few famous codebases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;spacing=10;" parent="solution" vertex="1">
                    <mxGeometry x="270" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="&lt;b&gt;Long-horizon task shape&lt;/b&gt;&lt;br&gt;Prompts stay shorter and behavior-focused, but the implementation scope is much larger." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="solution" vertex="1">
                    <mxGeometry x="510" y="50" width="210" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="&lt;b&gt;Behavioral verifiers&lt;/b&gt;&lt;br&gt;Scoring checks observable behavior, so multiple valid implementations can pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="solution" vertex="1">
                    <mxGeometry x="150" y="220" width="440" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="contrast" value="&lt;b&gt;DeepSWE shifts evaluation from recall-heavy patches to novel end-to-end engineering work&lt;/b&gt;" style="shape=mxgraph.flowchart.manualInput;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="770" y="255" width="120" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="workflow" value="&lt;b&gt;Why the benchmark works in practice&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="1640" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="w1" value="&lt;b&gt;1. Select active public repo&lt;/b&gt;&lt;br&gt;Require active maintenance, permissive licensing, and at least 500 GitHub stars." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;spacing=10;" parent="workflow" vertex="1">
                    <mxGeometry x="30" y="70" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w2" value="&lt;b&gt;2. Author task package&lt;/b&gt;&lt;br&gt;Create the prompt, handwritten verifier, and reference solution from scratch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="workflow" vertex="1">
                    <mxGeometry x="340" y="70" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w3" value="&lt;b&gt;3. Agent must explore and implement&lt;/b&gt;&lt;br&gt;Shorter prompts force codebase discovery, design judgment, and regression avoidance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="workflow" vertex="1">
                    <mxGeometry x="650" y="70" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w4" value="&lt;b&gt;4. Verifier grades behavior&lt;/b&gt;&lt;br&gt;Repeat runs, regression checks, and review reduce flaky or overfit scoring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="workflow" vertex="1">
                    <mxGeometry x="960" y="70" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w5" value="&lt;b&gt;5. Leaderboard better separates models&lt;/b&gt;&lt;br&gt;The result is a cleaner signal about real-world coding-agent capability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="workflow" vertex="1">
                    <mxGeometry x="1270" y="70" width="310" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;113 tasks&#xa;91 repos&#xa;5 languages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="860" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="&lt;b&gt;Task size&lt;/b&gt;&lt;br&gt;Mean ref solution&#xa;668 lines added&#xa;7 files edited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f99d;strokeColor=#65a30d;fontColor=#365314;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="400" y="860" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3" value="&lt;b&gt;Verifier quality&lt;/b&gt;&lt;br&gt;0.3% false positives&#xa;1.1% false negatives&#xa;1.4% disagreement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecdd3;strokeColor=#e11d48;fontColor=#881337;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="720" y="860" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="&lt;b&gt;Publication snapshot&lt;/b&gt;&lt;br&gt;May 26, 2026 leaderboard&#xa;gpt-5.5 at 70% ± 3%&#xa;wider gaps than public SWE-bench variants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="860" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m5" value="&lt;b&gt;Bottom line&lt;/b&gt;&lt;br&gt;DeepSWE works because it combines novel tasks, broader repos, larger implementation scope, and behavior-first grading." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#ca8a04;fontColor=#713f12;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1460" y="860" width="220" height="120" as="geometry"/>
                </mxCell>
