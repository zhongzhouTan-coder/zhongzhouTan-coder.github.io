<mxfile host="65bd71144e">
    <diagram id="deepswe-v1-1-explainer" name="DeepSWE v1.1 Explainer">
        <mxGraphModel dx="1913" dy="936" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;DeepSWE v1.1: Cleaner Execution and Scoring&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Same 113 tasks as v1, but benchmarked through committed-patch isolation, CTRF reports, and a cleaner git environment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1640" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="left" value="&lt;b&gt;What v1.1 needed to fix&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="420" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="&lt;b&gt;Environment leakage&lt;/b&gt;&lt;br&gt;Scores could depend on runtime changes left behind in the agent container." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="left" vertex="1">
                    <mxGeometry x="30" y="50" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="l2" value="&lt;b&gt;Limited audit trail&lt;/b&gt;&lt;br&gt;A simple pass or fail result hides which task-defining tests succeeded or failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#9a3412;spacing=10;" parent="left" vertex="1">
                    <mxGeometry x="30" y="165" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="l3" value="&lt;b&gt;Detached git workflow&lt;/b&gt;&lt;br&gt;Agents worked in a less natural git state while benchmark authors still wanted future history hidden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;spacing=10;" parent="left" vertex="1">
                    <mxGeometry x="30" y="280" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="pipeline" value="&lt;b&gt;How v1.1 executes a task&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="500" y="140" width="720" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b&gt;Agent container&lt;/b&gt;&lt;br&gt;Start on visible &lt;code style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;main&lt;/code&gt;, branch normally, implement the change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="30" y="150" width="180" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="&lt;b&gt;Commit patch&lt;/b&gt;&lt;br&gt;The benchmark records the committed diff instead of the full runtime state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="250" y="150" width="180" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="&lt;b&gt;Fresh verifier container&lt;/b&gt;&lt;br&gt;Apply only the diff inside a clean environment with fixed dependencies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="470" y="150" width="180" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="&lt;b&gt;CTRF report&lt;/b&gt;&lt;br&gt;Run task-defining tests and emit named per-test pass, fail, or missing status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="250" y="290" width="180" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p5" value="&lt;b&gt;Final score&lt;/b&gt;&lt;br&gt;Pass rate is tied to the submitted patch, not to agent-side runtime tricks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="470" y="290" width="180" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="banner" value="&lt;b&gt;Key mechanism:&lt;/b&gt; only the committed diff crosses from agent execution into scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#ca8a04;fontColor=#713f12;spacing=10;" parent="pipeline" vertex="1">
                    <mxGeometry x="120" y="50" width="480" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="right" value="&lt;b&gt;What this improves&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="140" width="420" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="&lt;b&gt;Reproducibility&lt;/b&gt;&lt;br&gt;A fresh verifier container makes grading easier to rerun and compare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="right" vertex="1">
                    <mxGeometry x="30" y="50" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="&lt;b&gt;Auditability&lt;/b&gt;&lt;br&gt;CTRF exposes partial progress and makes missing or dropped tests visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="right" vertex="1">
                    <mxGeometry x="30" y="165" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="&lt;b&gt;Anti-gaming&lt;/b&gt;&lt;br&gt;Monkey-patching the test runtime no longer helps because the runtime state is discarded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#9d174d;spacing=10;" parent="right" vertex="1">
                    <mxGeometry x="30" y="280" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="bottom" value="&lt;b&gt;Why the results still matter&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="600" width="1640" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="&lt;b&gt;Same corpus&lt;/b&gt;&lt;br&gt;DeepSWE v1.1 keeps the same 113 long-horizon tasks as v1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;spacing=10;" parent="bottom" vertex="1">
                    <mxGeometry x="30" y="70" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="&lt;b&gt;Top-level ordering stays close&lt;/b&gt;&lt;br&gt;The source treats v1.1 as a measurement cleanup, not a benchmark reset." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="bottom" vertex="1">
                    <mxGeometry x="290" y="70" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="&lt;b&gt;Example shifts&lt;/b&gt;&lt;br&gt;gpt-5.5: 70% → 67%&#xa;gpt-5.4: 56% → 52%&#xa;gemini-3.5-flash: 28% → 37%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="bottom" vertex="1">
                    <mxGeometry x="590" y="70" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="&lt;b&gt;Reporting changes&lt;/b&gt;&lt;br&gt;Wall-clock time is removed; pass rate, cost, output tokens, and agent steps remain visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="bottom" vertex="1">
                    <mxGeometry x="910" y="70" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="&lt;b&gt;New snapshot&lt;/b&gt;&lt;br&gt;Updated July 1, 2026&#xa;Claude Fable 5 leads at 70% ± 4%&#xa;Kimi K2.7 Code also appears in the table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="bottom" vertex="1">
                    <mxGeometry x="1270" y="70" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="summary" value="&lt;b&gt;Bottom line:&lt;/b&gt; v1.1 strengthens evaluation hygiene while largely preserving the benchmark signal seen in DeepSWE v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" parent="bottom" vertex="1">
                    <mxGeometry x="350" y="210" width="930" height="70" as="geometry"/>
                </mxCell>
