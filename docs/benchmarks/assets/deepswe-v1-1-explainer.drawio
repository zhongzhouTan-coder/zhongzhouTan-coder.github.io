                <mxCell id="e7" value="same benchmark, cleaner grading" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#334155;" parent="1" source="p5" target="summary" edge="1">
