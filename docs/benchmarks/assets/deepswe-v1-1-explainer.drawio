                <mxCell id="e4" value="committed diff&amp;nbsp;&lt;div&gt;only&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0c4a6e;" parent="1" source="p2" target="p3" edge="1">
