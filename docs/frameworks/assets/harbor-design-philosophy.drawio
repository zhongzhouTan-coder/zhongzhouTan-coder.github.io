                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="shareability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#14532d;" parent="1" source="a1" target="o3" edge="1">
                    <mxGeometry relative="1" as="geometry">
