<mxfile host="65bd71144e">
    <diagram id="harbor-design-philosophy" name="Harbor Design Philosophy">
        <mxGraphModel dx="1575" dy="912" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;Harbor Design Philosophy&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Why Harbor emerged, what principles it follows, and how those principles shape the framework&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#6c8ebf;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1520" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="pressures" value="&lt;b&gt;Pressures&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="150" width="360" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b&gt;Terminal-Bench was reused beyond one benchmark&lt;/b&gt;&lt;br&gt;custom evals, prompt optimization, RL rollouts, SFT traces, and CI-style agent testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="pressures" vertex="1">
                    <mxGeometry x="30" y="60" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="&lt;b&gt;Containerized agent tasks are operationally hard&lt;/b&gt;&lt;br&gt;environment setup, policy control, artifact collection, reproducibility, and cross-provider scaling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="pressures" vertex="1">
                    <mxGeometry x="30" y="210" width="300" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="&lt;b&gt;Harbor turns these into one framework problem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="pressures" vertex="1">
                    <mxGeometry x="30" y="375" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="principles" value="&lt;b&gt;Core principles&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;" parent="1" vertex="1">
                    <mxGeometry x="470" y="150" width="660" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;1. Task is the atomic unit&lt;/b&gt;&lt;br&gt;instruction + environment + verifier + policy must move together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="principles" vertex="1">
                    <mxGeometry x="35" y="60" width="250" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;2. Stable interfaces beat product-specific logic&lt;/b&gt;&lt;br&gt;agent, environment, trial, and job are separable so integrations stay replaceable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="principles" vertex="1">
                    <mxGeometry x="320" y="60" width="305" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&lt;b&gt;3. Portability over lock-in&lt;/b&gt;&lt;br&gt;the same task should run locally or on many cloud sandboxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="principles" vertex="1">
                    <mxGeometry x="35" y="185" width="250" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="&lt;b&gt;4. Verification is first-class&lt;/b&gt;&lt;br&gt;agent output is not enough; evaluation needs explicit evidence and grading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="principles" vertex="1">
                    <mxGeometry x="320" y="185" width="305" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="&lt;b&gt;5. Runtime policy must be explicit&lt;/b&gt;&lt;br&gt;network, resources, OS, verifier mode, and MCP servers belong in config, not hidden scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;spacing=10;" parent="principles" vertex="1">
                    <mxGeometry x="175" y="310" width="310" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="consequences" value="&lt;b&gt;Architecture consequences&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="150" width="360" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;Task format + dataset / registry model&lt;/b&gt;&lt;br&gt;portable package first, dataset second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="consequences" vertex="1">
                    <mxGeometry x="30" y="60" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;BaseAgent and BaseEnvironment abstractions&lt;/b&gt;&lt;br&gt;swap agents and providers without changing tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="consequences" vertex="1">
                    <mxGeometry x="30" y="175" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;Job -&gt; Trial orchestration&lt;/b&gt;&lt;br&gt;many reproducible runs from one config surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="consequences" vertex="1">
                    <mxGeometry x="30" y="290" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;Artifacts + separate verifier sandbox&lt;/b&gt;&lt;br&gt;evidence flow is part of the architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="consequences" vertex="1">
                    <mxGeometry x="30" y="405" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="outcomes" value="&lt;b&gt;What Harbor optimizes for&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="120" y="690" width="1360" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="o1" value="&lt;b&gt;Reproducible evaluation&lt;/b&gt;&lt;br&gt;task package and policy are visible; results are attached to artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;spacing=10;" parent="outcomes" vertex="1">
                    <mxGeometry x="45" y="85" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="o2" value="&lt;b&gt;Scalable experimentation&lt;/b&gt;&lt;br&gt;job and trial abstraction supports parallel local and cloud execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="outcomes" vertex="1">
                    <mxGeometry x="350" y="85" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="o3" value="&lt;b&gt;Shareable benchmark components&lt;/b&gt;&lt;br&gt;tasks and datasets behave like versioned distributable artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="outcomes" vertex="1">
                    <mxGeometry x="655" y="85" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="o4" value="&lt;b&gt;Trustworthy evidence&lt;/b&gt;&lt;br&gt;verification, sidecar evidence, and artifact handoff are explicit by design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="outcomes" vertex="1">
                    <mxGeometry x="960" y="85" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="drives the need" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c2410c;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c2d12;" parent="1" source="pressures" target="principles" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="principles shape implementation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1e3a8a;" parent="1" source="principles" target="consequences" edge="1">
                    <mxGeometry x="1" y="-18" relative="1" as="geometry">
                        <mxPoint x="9" y="-3" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e3" value="reproducibility" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#0f172a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="a1" target="o1" edge="1">
                    <mxGeometry relative="1" as="geometry">
