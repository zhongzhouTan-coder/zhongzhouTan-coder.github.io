                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" value="scale" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#1e3a8a;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="a3" target="o2" edge="1">
                    <mxGeometry relative="1" as="geometry">
