                <mxCell id="local" value="&lt;b&gt;Local directory&lt;/b&gt;&lt;br&gt;Run directly during development." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="dist" vertex="1">
                    <mxGeometry x="35" y="70" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="registry" value="&lt;b&gt;Harbor registry&lt;/b&gt;&lt;br&gt;Immutable task and dataset snapshots identified by digest, revision, and tags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#1d4ed8;fontColor=#1e3a8a;spacing=10;" parent="dist" vertex="1">
                    <mxGeometry x="35" y="200" width="230" height="115" as="geometry"/>
                </mxCell>
