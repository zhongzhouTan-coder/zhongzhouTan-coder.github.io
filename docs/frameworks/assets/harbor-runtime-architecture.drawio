    <diagram id="harbor-runtime-architecture" name="Harbor Runtime Architecture">
        <mxGraphModel dx="1430" dy="969" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#f8fafc" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;Harbor Framework Architecture&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;Portable task packages flow through registry distribution, job orchestration, sandboxed agent execution, verification, evidence collection, and sharing surfaces.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=14;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1840" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="author" value="&lt;b&gt;1. Authoring boundary&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="300" height="610" as="geometry"/>
                </mxCell>
                <mxCell id="taskpkg" value="&lt;b&gt;Task package&lt;/b&gt;&lt;br&gt;instruction.md&lt;br&gt;task.toml&lt;br&gt;environment/&lt;br&gt;tests/&lt;br&gt;solution/ optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;spacing=10;" parent="author" vertex="1">
                    <mxGeometry x="35" y="65" width="230" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="policy" value="&lt;b&gt;Runtime policy&lt;/b&gt;&lt;br&gt;network mode, resources, user, OS, MCP servers, healthchecks, verifier mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="author" vertex="1">
                    <mxGeometry x="35" y="245" width="230" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="datasetdef" value="&lt;b&gt;Dataset composition&lt;/b&gt;&lt;br&gt;Tasks become benchmark slices that can be reused across jobs and experiments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="author" vertex="1">
                    <mxGeometry x="35" y="405" width="230" height="115" as="geometry"/>
                </mxCell>
