<mxfile host="65bd71144e">
    <diagram id="harbor-architecture" name="Harbor Architecture"><mxGraphModel dx="1116" dy="712" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;Harbor: Why It Exists and How the Architecture Works&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Portable task packages, pluggable agents and sandbox providers, explicit verification, and scalable trial orchestration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=12;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1640" height="90" as="geometry"/></mxCell><mxCell id="why" value="&lt;b&gt;Why Harbor exists&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1"><mxGeometry x="40" y="140" width="480" height="400" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Terminal-Bench outgrew one benchmark&lt;/b&gt;&lt;br&gt;Users wanted custom evals, prompt optimization, RL rollouts, SFT traces, and CI-style agent testing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="why" vertex="1"><mxGeometry x="30" y="60" width="190" height="120" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Containerized tasks are hard to manage at scale&lt;/b&gt;&lt;br&gt;Task packaging, sandbox setup, verification, artifacts, and provider differences create systems complexity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="why" vertex="1"><mxGeometry x="250" y="60" width="200" height="120" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Goal&lt;/b&gt;&lt;br&gt;Turn agent evaluation into a reusable framework with one task format, one runtime model, and many interchangeable agents and environments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="why" vertex="1"><mxGeometry x="30" y="225" width="420" height="120" as="geometry"/></mxCell><mxCell id="bridge" value="&lt;b&gt;Core design choice&lt;/b&gt;&lt;br&gt;The task is the atomic portable unit" style="shape=mxgraph.flowchart.manualInput;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="260" width="140" height="160" as="geometry"/></mxCell><mxCell id="arch" value="&lt;b&gt;Execution architecture&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;" parent="1" vertex="1"><mxGeometry x="740" y="140" width="940" height="400" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Task format&lt;/b&gt;&lt;br&gt;`instruction.md` + `task.toml` + `environment/` + `tests/`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="arch" vertex="1"><mxGeometry x="20" y="70" width="150" height="110" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Dataset / Registry&lt;/b&gt;&lt;br&gt;Local tasks, Harbor registry datasets, or Git repository datasets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;spacing=10;" parent="arch" vertex="1"><mxGeometry x="190" y="70" width="150" height="110" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Job&lt;/b&gt;&lt;br&gt;Resolve task configs, build trial configs, cache tasks, apply metrics and retry policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="arch" vertex="1"><mxGeometry x="360" y="70" width="150" height="110" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Trial queue&lt;/b&gt;&lt;br&gt;Fan out trials concurrently with per-agent and job-level concurrency control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="arch" vertex="1"><mxGeometry x="530" y="70" width="150" height="110" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Trial&lt;/b&gt;&lt;br&gt;Create agent and environment, run lifecycle hooks, collect evidence, persist outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="arch" vertex="1"><mxGeometry x="700" y="70" width="150" height="110" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Agent adapter&lt;/b&gt;&lt;br&gt;`BaseAgent` setup/run contract keeps agents interchangeable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;spacing=10;" parent="arch" vertex="1"><mxGeometry x="120" y="235" width="170" height="110" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;Environment provider&lt;/b&gt;&lt;br&gt;`BaseEnvironment` enforces build, mounts, resources, healthchecks, network policy, and artifact transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="arch" vertex="1"><mxGeometry x="320" y="235" width="230" height="110" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;Shared sandbox or separate verifier sandbox with explicit artifact handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="arch" vertex="1"><mxGeometry x="580" y="235" width="170" height="110" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;Artifacts and results&lt;/b&gt;&lt;br&gt;`result.json`, logs, trajectories, artifact manifest, viewer-compatible trial directory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="arch" vertex="1"><mxGeometry x="780" y="235" width="140" height="110" as="geometry"/></mxCell><mxCell id="e3" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;package tasks&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1e3a8a;" parent="arch" source="a1" target="a2" edge="1"><mxGeometry y="15" relative="1" as="geometry"><mxPoint x="-1" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;resolve inputs&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;fontColor=#0c4a6e;" parent="arch" source="a2" target="a3" edge="1"><mxGeometry y="15" relative="1" as="geometry"><mxPoint x="-1" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;emit trials&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;fontColor=#14532d;" parent="arch" source="a3" target="a4" edge="1"><mxGeometry y="15" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontColor=#134e4a;" parent="arch" source="a4" target="a5" edge="1"><mxGeometry y="15" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e7" value="instantiate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c026d3;strokeWidth=2;endArrow=block;endFill=1;fontColor=#701a75;" parent="arch" source="a5" target="a6" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="200"/><mxPoint x="205" y="200"/></Array></mxGeometry></mxCell><mxCell id="e8" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;run inside&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontColor=#4c1d95;" parent="arch" source="a6" target="a7" edge="1"><mxGeometry x="-0.3333" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;verify output&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;fontColor=#78350f;" parent="arch" source="a7" target="a8" edge="1"><mxGeometry x="-0.3333" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e10" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;persist evidence&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7f1d1d;" parent="arch" source="a8" target="a9" edge="1"><mxGeometry x="0.3333" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e1" value="portable task unit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c2410c;strokeWidth=2;endArrow=block;endFill=1;fontColor=#7c2d12;" parent="1" source="why" target="bridge" edge="1"><mxGeometry x="-0.1097" y="-10" relative="1" as="geometry"><mxPoint x="-10" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="drives framework structure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;fontColor=#134e4a;" parent="1" source="bridge" target="arch" edge="1"><mxGeometry x="0.5561" y="-20" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="surround" value="&lt;b&gt;Surrounding platform capabilities&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" parent="1" vertex="1"><mxGeometry x="40" y="580" width="1640" height="270" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Policy as configuration&lt;/b&gt;&lt;br&gt;Network mode, allowlists, resources, MCP servers, OS, verifier mode, and healthchecks live in task config." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;spacing=10;" parent="surround" vertex="1"><mxGeometry x="25" y="85" width="240" height="120" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Reproducible distribution&lt;/b&gt;&lt;br&gt;Registry snapshots version tasks and datasets by digest, revision, and tags instead of treating the registry as a development workspace." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="surround" vertex="1"><mxGeometry x="300" y="85" width="250" height="120" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Portable execution backends&lt;/b&gt;&lt;br&gt;One trial lifecycle can target Docker or multiple cloud sandbox providers through the environment abstraction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="surround" vertex="1"><mxGeometry x="585" y="85" width="250" height="120" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Trustworthy evaluation&lt;/b&gt;&lt;br&gt;Separate verifier sandboxes and sidecar artifact collection reduce trust in mutable live container state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="surround" vertex="1"><mxGeometry x="870" y="85" width="230" height="120" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Sharing and review&lt;/b&gt;&lt;br&gt;Viewer, Hub upload, job sharing, and leaderboard submission sit on top of the same job and trial outputs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="surround" vertex="1"><mxGeometry x="1135" y="85" width="220" height="120" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Best mental model&lt;/b&gt;&lt;br&gt;Packaging layer + orchestration layer + execution layer + evidence layer + sharing layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fecdd3;strokeColor=#e11d48;fontColor=#881337;spacing=10;" parent="surround" vertex="1"><mxGeometry x="1390" y="85" width="220" height="120" as="geometry"/></mxCell><mxCell id="e11" value="configurable policies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#0f172a;" parent="1" source="s1" target="a7" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="830"/><mxPoint x="1175" y="830"/></Array></mxGeometry></mxCell><mxCell id="e12" value="shareable tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#1e3a8a;" parent="1" source="s2" target="a2" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="630"/><mxPoint x="1005" y="630"/></Array></mxGeometry></mxCell><mxCell id="e13" value="provider portability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#14532d;" parent="1" source="s3" target="a7" edge="1"><mxGeometry x="-0.1573" relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="650"/><mxPoint x="1140" y="650"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e14" value="isolation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#78350f;" parent="1" source="s4" target="a8" edge="1"><mxGeometry x="-0.0959" relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="810"/><mxPoint x="1405" y="810"/></Array><mxPoint x="-1" as="offset"/></mxGeometry></mxCell><mxCell id="e15" value="upload / inspect / submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c026d3;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#701a75;" parent="1" source="a9" target="s5" edge="1"><mxGeometry x="0.1755" y="-10" relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="520"/><mxPoint x="1285" y="520"/></Array><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram>
</mxfile>