    <diagram id="intrinsic-dimension-finetuning" name="Intrinsic Dimension Fine-Tuning">
        <mxGraphModel dx="1679" dy="954" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;Intrinsic Dimensionality Explains Language Model Fine-Tuning&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;A pretrained model can turn downstream tasks into compact low-dimensional updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontStyle=1;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="20" width="1600" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="problem" value="&lt;b&gt;Fine-tuning puzzle&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#7c2d12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="150" width="470" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="Huge pretrained model&lt;br&gt;&lt;b&gt;D = hundreds of millions&lt;/b&gt; parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontColor=#7c2d12;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="30" y="60" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="Small labeled dataset&lt;br&gt;Often only hundreds or thousands of examples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="250" y="60" width="190" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="Question&lt;br&gt;Why does relatively vanilla gradient descent generalize?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;spacing=10;" parent="problem" vertex="1">
                    <mxGeometry x="90" y="185" width="290" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="method" value="&lt;b&gt;Intrinsic-dimension fine-tuning&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" parent="1" vertex="1">
                    <mxGeometry x="620" y="150" width="500" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="Train only a small vector&lt;br&gt;&lt;b&gt;theta_d&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="method" vertex="1">
                    <mxGeometry x="30" y="70" width="130" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="Fixed random projection&lt;br&gt;&lt;b&gt;P: R^d to R^D&lt;/b&gt;&lt;br&gt;Fastfood makes it feasible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f99d;strokeColor=#65a30d;fontColor=#365314;spacing=10;" parent="method" vertex="1">
                    <mxGeometry x="190" y="60" width="140" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="m3" value="Full update&lt;br&gt;&lt;b&gt;theta_D = theta_D0 + P(theta_d)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#134e4a;spacing=10;" parent="method" vertex="1">
                    <mxGeometry x="360" y="70" width="110" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="d90 = smallest d that reaches 90% of full fine-tuning performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfccb;strokeColor=#84cc16;fontColor=#365314;spacing=10;" parent="method" vertex="1">
                    <mxGeometry x="80" y="190" width="340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="variants" value="&lt;b&gt;Two measured variants&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#312e81;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="150" width="430" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="v1" value="&lt;b&gt;DID&lt;/b&gt;&lt;br&gt;Direct Intrinsic Dimension&lt;br&gt;Structure-unaware projection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontColor=#312e81;spacing=10;" parent="variants" vertex="1">
                    <mxGeometry x="40" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="v2" value="&lt;b&gt;SAID&lt;/b&gt;&lt;br&gt;Structure-Aware Intrinsic Dimension&lt;br&gt;Adds learned layer scales lambda_i" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;spacing=10;" parent="variants" vertex="1">
                    <mxGeometry x="240" y="70" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="finding" value="&lt;b&gt;Empirical findings&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="470" width="1600" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="&lt;b&gt;Tiny task dimensions&lt;/b&gt;&lt;br&gt;RoBERTa-Large reaches MRPC d90 near 200 with SAID." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;spacing=10;" parent="finding" vertex="1">
                    <mxGeometry x="40" y="80" width="260" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="&lt;b&gt;Pretraining lowers d90&lt;/b&gt;&lt;br&gt;RoBERTa checkpoints show downstream intrinsic dimension falling over pretraining updates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;spacing=10;" parent="finding" vertex="1">
                    <mxGeometry x="350" y="80" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="&lt;b&gt;Larger models often compress better&lt;/b&gt;&lt;br&gt;Across model families, parameter count trends inversely with MRPC d90." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;spacing=10;" parent="finding" vertex="1">
                    <mxGeometry x="680" y="80" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="&lt;b&gt;Lower d90 tracks generalization&lt;/b&gt;&lt;br&gt;Lower intrinsic dimension correlates with higher eval accuracy and smaller relative gap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;fontColor=#701a75;spacing=10;" parent="finding" vertex="1">
                    <mxGeometry x="1010" y="80" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="&lt;b&gt;Bound depends on d, not D&lt;/b&gt;&lt;br&gt;L0(f) &amp;lt;= Lhat0(f) + O(sqrt(d / m)) for intrinsic-subspace training." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;spacing=10;" parent="finding" vertex="1">
                    <mxGeometry x="1340" y="80" width="220" height="110" as="geometry"/>
                </mxCell>
