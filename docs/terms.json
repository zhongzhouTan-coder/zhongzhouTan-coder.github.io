---
layout: null
permalink: /terms.json
---
[
{%- assign term_pages = site.pages | where_exp: "item", "item.path contains 'terms/'" | sort: "title" -%}
{%- assign first = true -%}
{%- for term in term_pages -%}
  {%- if term.path != "terms/index.md" -%}
    {%- assign preview = term.tooltip | default: term.summary -%}
    {%- if preview == nil or preview == "" -%}
      {%- assign preview = term.content | markdownify | strip_html | normalize_whitespace | truncate: 260 -%}
    {%- endif -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false -%}
    {
      "title": {{ term.title | jsonify }},
      "url": {{ term.url | relative_url | jsonify }},
      "tooltip": {{ preview | jsonify }},
      "backlinks": [
        {%- assign backlink_first = true -%}
        {%- for consumer in site.pages -%}
          {%- unless consumer.path contains "terms/" -%}
            {%- unless consumer.path contains "logs/" -%}
              {%- if consumer.content contains term.path -%}
                {%- unless backlink_first -%},{%- endunless -%}
                {%- assign backlink_first = false -%}
                {
                  "title": {{ consumer.title | default: consumer.path | jsonify }},
                  "url": {{ consumer.url | relative_url | jsonify }}
                }
              {%- endif -%}
            {%- endunless -%}
          {%- endunless -%}
        {%- endfor -%}
      ]
    }
  {%- endif -%}
{%- endfor -%}
]
